<?xml version="1.0" encoding="utf-8"?>
<!--
  Decision: two feeds with source mapping: nuget.org for everything, GitHub Packages only for Operandor.*.
  Why: the operandor design system is published to GitHub Packages, which needs a token even to read; mapping only
  its id prefix there keeps every other package's origin fixed, so no feed can serve a look-alike.
  Considered: GitHub Packages for all packages (it proxies nuget.org), which needs a token for every restore.
  Credentials are never stored here: NuGet reads them from the NuGetPackageSourceCredentials_github environment
  variable, which CI sets from its token and a developer from a personal access token with read:packages (see README).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/sipos-andor/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Operandor.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
