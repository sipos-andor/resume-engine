<?xml version="1.0" encoding="utf-8"?>
<!--
  Decision: two feeds with source mapping: nuget.org for explicitly mapped public package IDs, GitHub Packages only for Operandor.*.
  Why: the operandor design system is published to GitHub Packages, which needs a token even to read; mapping only
  its id prefix there keeps every other package's origin fixed, so no feed can serve a look-alike.
  Considered: GitHub Packages for all packages (it proxies nuget.org), which needs a token for every restore.
  Credentials are never stored here: NuGet reads them from the NuGetPackageSourceCredentials_github environment
  variable, which CI sets from its token and a developer from a personal access token with read:packages (see README).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/sipos-andor/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Operandor.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Acornima" />
      <package pattern="AngleSharp" />
      <package pattern="AngleSharp.Css" />
      <package pattern="AngleSharp.Diffing" />
      <package pattern="bunit" />
      <package pattern="coverlet.collector" />
      <package pattern="CycleDetection" />
      <package pattern="DiffEngine" />
      <package pattern="DocumentFormat.OpenXml" />
      <package pattern="DocumentFormat.OpenXml.Framework" />
      <package pattern="EmptyFiles" />
      <package pattern="JetBrains.Annotations" />
      <package pattern="Jint" />
      <package pattern="Markdig" />
      <package pattern="Microsoft.ApplicationInsights" />
      <package pattern="Microsoft.AspNetCore.Authorization" />
      <package pattern="Microsoft.AspNetCore.Components" />
      <package pattern="Microsoft.AspNetCore.Components.Analyzers" />
      <package pattern="Microsoft.AspNetCore.Components.Authorization" />
      <package pattern="Microsoft.AspNetCore.Components.Forms" />
      <package pattern="Microsoft.AspNetCore.Components.Web" />
      <package pattern="Microsoft.AspNetCore.Components.WebAssembly" />
      <package pattern="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
      <package pattern="Microsoft.AspNetCore.Metadata" />
      <package pattern="Microsoft.Bcl.AsyncInterfaces" />
      <package pattern="Microsoft.CodeCoverage" />
      <package pattern="Microsoft.Extensions.Caching.Abstractions" />
      <package pattern="Microsoft.Extensions.Caching.Memory" />
      <package pattern="Microsoft.Extensions.Configuration" />
      <package pattern="Microsoft.Extensions.Configuration.Abstractions" />
      <package pattern="Microsoft.Extensions.Configuration.Binder" />
      <package pattern="Microsoft.Extensions.Configuration.FileExtensions" />
      <package pattern="Microsoft.Extensions.Configuration.Json" />
      <package pattern="Microsoft.Extensions.DependencyInjection" />
      <package pattern="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <package pattern="Microsoft.Extensions.Diagnostics" />
      <package pattern="Microsoft.Extensions.Diagnostics.Abstractions" />
      <package pattern="Microsoft.Extensions.FileProviders.Abstractions" />
      <package pattern="Microsoft.Extensions.FileProviders.Physical" />
      <package pattern="Microsoft.Extensions.FileSystemGlobbing" />
      <package pattern="Microsoft.Extensions.Localization.Abstractions" />
      <package pattern="Microsoft.Extensions.Logging" />
      <package pattern="Microsoft.Extensions.Logging.Abstractions" />
      <package pattern="Microsoft.Extensions.Logging.Configuration" />
      <package pattern="Microsoft.Extensions.Logging.Console" />
      <package pattern="Microsoft.Extensions.Options" />
      <package pattern="Microsoft.Extensions.Options.ConfigurationExtensions" />
      <package pattern="Microsoft.Extensions.Primitives" />
      <package pattern="Microsoft.Extensions.Validation" />
      <package pattern="Microsoft.JSInterop" />
      <package pattern="Microsoft.JSInterop.WebAssembly" />
      <package pattern="Microsoft.NET.ILLink.Tasks" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="Microsoft.Testing.Extensions.Telemetry" />
      <package pattern="Microsoft.Testing.Extensions.TrxReport.Abstractions" />
      <package pattern="Microsoft.Testing.Platform" />
      <package pattern="Microsoft.Testing.Platform.MSBuild" />
      <package pattern="Microsoft.TestPlatform.ObjectModel" />
      <package pattern="Microsoft.TestPlatform.TestHost" />
      <package pattern="Microsoft.Win32.Registry" />
      <package pattern="Microsoft.Win32.SystemEvents" />
      <package pattern="MinVer" />
      <package pattern="Mono.Cecil" />
      <package pattern="Namotion.Reflection" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="NJsonSchema" />
      <package pattern="NJsonSchema.Annotations" />
      <package pattern="PdfPig" />
      <package pattern="QRCoder" />
      <package pattern="QuestPDF" />
      <package pattern="Shouldly" />
      <package pattern="System.CodeDom" />
      <package pattern="System.Drawing.Common" />
      <package pattern="System.IO.Packaging" />
      <package pattern="System.Management" />
      <package pattern="System.ValueTuple" />
      <package pattern="TngTech.ArchUnitNET" />
      <package pattern="TngTech.ArchUnitNET.xUnitV3" />
      <package pattern="xunit.analyzers" />
      <package pattern="xunit.runner.visualstudio" />
      <package pattern="xunit.v3" />
      <package pattern="xunit.v3.assert" />
      <package pattern="xunit.v3.common" />
      <package pattern="xunit.v3.core.mtp-v1" />
      <package pattern="xunit.v3.extensibility.core" />
      <package pattern="xunit.v3.mtp-v1" />
      <package pattern="xunit.v3.runner.common" />
      <package pattern="xunit.v3.runner.inproc.console" />
    </packageSource>
  </packageSourceMapping>
</configuration>
