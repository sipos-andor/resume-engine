@namespace Sipos.Resume.Theme.Operandor.Sections

<span class="cv-skill__label">
    <span class="cv-skill__name">@Skill.Name</span>
    @if (LastUse is { } lastUse)
    {
        <span class="cv-skill__used">@lastUse</span>
    }
</span>
@if (Skill.Rating is { } rating)
{
    <SkillMeter Rating="rating" />
}
@if (View.Level(Skill) is { } level)
{
    <span class="cv-skill__level">@level</span>
}

@code {
    [CascadingParameter] internal ResumeView View { get; set; } = default!;

    /// <summary>The skill.</summary>
    [Parameter, EditorRequired] public Skill Skill { get; set; } = default!;

    // Every skill tells when it was used last, under its name; one no dated item shows tells nothing.
    private string? LastUse => View.Page.Insights.Evidence.GetValueOrDefault(Skill.Name) switch
    {
        { Ongoing: true } => View.Labels.InUse,
        { LastYear: { } year } => View.Labels.LastUsed(year),
        _ => null,
    };
}
