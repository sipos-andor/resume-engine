<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>The resume engine's core: JSON Resume reading and validation, the domain model, cross-language checks, derived data, labels in four languages and the ports the build plugs into.</Description>
    <!--
      Decision: trimmable and AOT-compatible, with one package dependency: the dependency injection abstractions, which
      the theme contract (IResumeTheme) registers its services through.
      Why: the same core runs at build time and in the browser (the Studio, a WebAssembly app), where every byte is a
      download; JSON goes through a source-generated context, so nothing is reached by reflection alone.
    -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sipos.Resume.Core.Tests" />
  </ItemGroup>

</Project>
